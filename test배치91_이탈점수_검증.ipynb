   "source": [
    "# 변수별 표준화 거리(normalized RMSE)로 재계산\n",
    "# 원 단위 RMSE는 DO2 하나가 평균을 지배하는 문제가 있어,\n",
    "# 각 변수를 골든배치 자체의 표준편차로 나눠서 스케일을 맞춘 뒤 비교\n",
    "\n",
    "def get_pre_fault_distance_normalized(strategy, cols, cutoff=0.0775):\n",
    "    band_sub = bands[strategy][bands[strategy]['공정진행률'] <= cutoff]\n",
    "    distances = {}\n",
    "    for col in cols:\n",
    "        interp = PchipInterpolator(pre_fault['공정진행률'], pre_fault[col])\n",
    "        b91_interp = interp(band_sub['공정진행률'])\n",
    "\n",
    "        raw_rmse = np.sqrt(np.mean((b91_interp - band_sub[f'{col}_mean'].values) ** 2))\n",
    "        # 골든배치 자체의 평균 표준편차로 정규화 (0으로 나누기 방지)\n",
    "        scale = max(band_sub[f'{col}_std'].mean(), 1e-6)\n",
    "        distances[col] = raw_rmse / scale\n",
    "    return distances\n",
    "\n",
    "print(\"=== 변수별 표준화 거리(normalized RMSE) ===\")\n",
    "for strategy in ['RC', 'OC', 'APC']:\n",
    "    dist = get_pre_fault_distance_normalized(strategy, compare_cols)\n",
    "    avg_dist = np.mean(list(dist.values()))\n",
    "    print(f\"{strategy}: {dist}, 평균={avg_dist:.4f}\")"
   ]
