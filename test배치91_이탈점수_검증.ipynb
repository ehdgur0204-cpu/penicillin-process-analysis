   "source": [
    "# Batch91 Fault 이전 구간(0~7.75%) 추출\n",
    "batch91 = df[df[batch_col] == 91].sort_values(time_col).copy()\n",
    "batch91['공정진행률'] = batch91[time_col] / batch91[time_col].max()\n",
    "pre_fault = batch91[batch91['공정진행률'] <= 0.0775].copy()\n",
    "\n",
    "# RC·OC·APC 프로파일과 RMSE 거리 비교\n",
    "compare_cols = [p_col, '용존산소_DO2', 'pH', '발효온도_T']\n",
    "\n",
    "def get_pre_fault_distance(strategy, cols, cutoff=0.0775):\n",
    "    band_sub = bands[strategy][bands[strategy]['공정진행률'] <= cutoff]\n",
    "    distances = {}\n",
    "    for col in cols:\n",
    "        interp = PchipInterpolator(pre_fault['공정진행률'], pre_fault[col])\n",
    "        b91_interp = interp(band_sub['공정진행률'])\n",
    "        distances[col] = np.sqrt(np.mean((b91_interp - band_sub[f'{col}_mean'].values) ** 2))\n",
    "    return distances\n",
    "\n",
    "for strategy in ['RC', 'OC', 'APC']:\n",
    "    dist = get_pre_fault_distance(strategy, compare_cols)\n",
    "    print(f\"{strategy}: {dist}, 평균={np.mean(list(dist.values())):.4f}\")"
