# Python 가상환경
.venv/
venv/

# Python 임시파일
**/__pycache__/
*.py[cod]
.pytest_cache/
.mypy_cache/
.ruff_cache/
.ipynb_checkpoints/

# 환경변수
.env
.env.*
!.env.example

# 원본 및 처리 데이터
data/raw/*
data/interim/*
data/processed/*

# 데이터 폴더 구조 유지 파일은 업로드
!data/raw/.gitkeep
!data/interim/.gitkeep
!data/processed/.gitkeep

# 분석 및 모델 결과
outputs/figures/*
outputs/tables/*
outputs/models/*

# 결과 폴더 구조 유지 파일은 업로드
!outputs/figures/.gitkeep
!outputs/tables/.gitkeep
!outputs/models/.gitkeep

# 편집기 및 운영체제 임시파일
.vscode/
.idea/
.DS_Store
Thumbs.db

# CSV 데이터는 GitHub에 업로드하지 않음
*.csv